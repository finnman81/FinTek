# Anchorpoint Next.js frontend
# Copy to .env.local

# Backend API: if unset, requests go to same origin and Next.js proxies /api/v1/* to API_BACKEND_URL.
# Set NEXT_PUBLIC_API_URL to call the backend directly (e.g. http://localhost:8000).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Proxy target (server-side; used when NEXT_PUBLIC_API_URL is unset). Default: http://localhost:8000
# API_BACKEND_URL=http://localhost:8000

# Optional: default tenant ID for development (claw-demo tenant from seed)
# NEXT_PUBLIC_DEFAULT_TENANT_ID=084fd0d0-043c-4ac9-b995-4faa773c0b32
