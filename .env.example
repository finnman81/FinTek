# Anchorpoint — Environment variables
# Copy to .env and fill in values. Do not commit .env.

# Required for OpenAI LLM and embeddings
OPENAI_API_KEY=sk-...

# Required for production (Postgres with pgvector). Used by API, worker, and migrations.
DATABASE_URL=postgresql://user:password@host:5432/anchorpoint

# Optional overrides (defaults come from config/settings.yaml)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# VECTORSTORE_PROVIDER=pgvector
# LOG_LEVEL=INFO

# Dev: default tenant when X-Tenant-ID is not sent (e.g. local testing). Use slug or UUID.
# DEFAULT_TENANT_SLUG=claw-demo
# DEFAULT_TENANT_ID=084fd0d0-043c-4ac9-b995-4faa773c0b32

# Optional: Clerk (when auth is enabled)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# CLERK_JWT_ISSUER=https://...clerk.accounts.dev
